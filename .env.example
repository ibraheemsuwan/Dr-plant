# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.

# Database (use letters/digits only, to avoid escaping problems in the connection string)
DB_PASSWORD=change-me

# Secret shared between the API and the model service
# generate: openssl rand -hex 32
MODEL_API_KEY=

# JWT signing key, 64+ random characters.   generate: openssl rand -base64 48
JWT_KEY=

# Image storage. "Local" (default) keeps photos on this server's disk; no third-party account needed.
# "Cloudinary" uses the hosted service instead (then fill in the three CLOUDINARY_* values).
STORAGE_PROVIDER=Local
# Public address of this API, used to build image URLs when STORAGE_PROVIDER=Local (no trailing slash)
PUBLIC_API_URL=http://localhost:8080

# Cloudinary (only if STORAGE_PROVIDER=Cloudinary): https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin allowed by CORS, no trailing slash
FRONTEND_ORIGIN=https://dr-plant.netlify.app

# Outgoing email (password reset links). Any SMTP service works: Brevo, Resend, Mailgun, SendGrid, Gmail app password...
# Without it the app still runs, but "Forgot password" cannot send emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# First admin account, created on first start if it doesn't exist (password 10+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Claude vision fallback for low-confidence photos. Leave empty to disable.
ANTHROPIC_API_KEY=
